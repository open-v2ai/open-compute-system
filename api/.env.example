APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./open_compute_system.db
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=
CELERY_QUEUE=celery
SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=http://127.0.0.1:3000
ADMIN_ORIGIN=http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MOCK_PROVIDER_DELAY_SECONDS=0.35
DEMO_AUTO_DISPATCH=true
DEMO_SEED_ENABLED=true
SELF_REGISTRATION_ENABLED=true
ADMIN_LOGIN_ENABLED=true
ALLOW_MOCK_PROVIDER_IN_PRODUCTION=false
ALLOW_MOCK_INFERENCE_IN_PRODUCTION=false
# Optional: real inference replica credentials reference environment variables by name.
# EXAMPLE_VLLM_API_KEY=replace-with-upstream-key
PRIVATE_NODE_AGENT_TOKEN=
VLLM_INTERNAL_API_KEY=
HF_TOKEN=
# Production only. Use a secret manager; do not commit the real Base32 value.
ADMIN_MFA_TOTP_SECRET=
SESSION_COOKIE_SECURE=false
# Public Mock demo only; requires HTTPS and disabled admin/self-registration.
PUBLIC_DEMO_ENABLED=false
COOKIE_PATH=/
