POSTGRES_DB=open_compute_system
POSTGRES_USER=open_compute_system
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_MFA_TOTP_SECRET=replace-with-a-base32-totp-secret
PUBLIC_HOST=compute.example.com
ADMIN_HOST=ops.compute.example.com
TLS_CERT_PATH=/absolute/path/to/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/privkey.pem

# Private GPU node Agent. Use independent high-entropy values.
PRIVATE_NODE_AGENT_TOKEN=replace-with-at-least-32-random-characters
VLLM_INTERNAL_API_KEY=replace-with-at-least-32-random-characters
HF_TOKEN=
AGENT_TRUSTED_HOSTS=127.0.0.1,gpu-node.internal
AGENT_LISTEN_HOST=127.0.0.1
VLLM_ADVERTISED_HOST=127.0.0.1
VLLM_BIND_HOST=127.0.0.1
# Pin a version or digest that has passed acceptance on the target GPU hosts.
VLLM_DEFAULT_IMAGE=vllm/vllm-openai:<tested-version>
VLLM_IMAGE_ALLOWLIST=vllm/vllm-openai:
MODEL_CACHE_HOST_PATH=/var/lib/open-compute-agent/huggingface

# Optional: shared/external dependency mode (python3 deploy/compose.py --dependencies external ...)
# Copy these from shared-services/.projects/<project>.env; never use administrator credentials.
# DATABASE_URL=postgresql+asyncpg://project:password@v2ai-shared-postgres:5432/project
# REDIS_URL=redis://project:password@v2ai-shared-redis:6379/0
REDIS_KEY_PREFIX=open_compute_system
CELERY_QUEUE=open_compute_system
SHARED_NETWORK=v2ai-infra
WORKER_CONCURRENCY=2

# Optional SSH-only preview overlay; not a public production deployment.
PREVIEW_ORIGIN=http://127.0.0.1:3003
APP_HTTP_PORT=18081

# Runtime ceilings; size these from measurements and expected concurrency.
API_MEMORY_LIMIT=512m
WEB_MEMORY_LIMIT=512m
WORKER_MEMORY_LIMIT=512m
SCHEDULER_MEMORY_LIMIT=192m

# Optional --demo-lite (implies private --preview; no worker/scheduler).
DEMO_API_MEMORY_LIMIT=192m
DEMO_WEB_MEMORY_LIMIT=192m

# Optional public Mock demo (implies --demo-lite, HTTPS cookies and disabled admin access).
DEMO_ORIGIN=https://demo.v2ai.org
DEMO_HOST=demo.v2ai.org
PUBLIC_BASE_PATH=/open-compute-system
PUBLIC_DEMO_PORT=18173
