AGENT_ENV=development
AGENT_TOKEN=open-compute-agent-local-development-token
TRUSTED_HOSTS=localhost,127.0.0.1
DOCKER_BINARY=docker
NVIDIA_SMI_BINARY=nvidia-smi
VLLM_DEFAULT_IMAGE=vllm/vllm-openai:latest
VLLM_IMAGE_ALLOWLIST=vllm/vllm-openai:
MODEL_CACHE_DIR=/var/lib/open-compute-agent/huggingface
VLLM_BIND_HOST=127.0.0.1
VLLM_ADVERTISED_HOST=127.0.0.1
# Optional. The deployment request references this environment variable by name.
HF_TOKEN=
VLLM_INTERNAL_API_KEY=
